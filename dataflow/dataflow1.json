{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Del1MBGT_Inside",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SQL_SRC_DS_copy1",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "alterRow1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          track_id as integer,",
				"          track_name as decimal(10,0),",
				"          artist_id as integer,",
				"          album_name as decimal(10,0),",
				"          duration_sec as integer,",
				"          release_date as date,",
				"          updated_at as timestamp 'yyyy.MM.dd HH:mm:ss'",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 alterRow(insertIf(1 == 1)) ~> alterRow1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          track_id,",
				"          track_name,",
				"          artist_id,",
				"          album_name,",
				"          duration_sec,",
				"          release_date,",
				"          updated_at",
				"     )) ~> sink1"
			]
		}
	}
}