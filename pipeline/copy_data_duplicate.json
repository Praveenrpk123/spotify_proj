{
	"name": "copy_data_duplicate",
	"properties": {
		"activities": [
			{
				"name": "Copy data1",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "Source",
						"value": "dbo.employee_events"
					},
					{
						"name": "Destination",
						"value": "interview-prep/Files_3/@{concat('dup_data_',utcNow())}"
					}
				],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings",
							"copyBehavior": "FlattenHierarchy"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "emp_id",
									"type": "Int32",
									"physicalType": "int"
								},
								"sink": {
									"name": "emp_id",
									"type": "String",
									"physicalType": "String"
								}
							},
							{
								"source": {
									"name": "emp_name",
									"type": "String",
									"physicalType": "varchar"
								},
								"sink": {
									"name": "emp_name",
									"type": "String",
									"physicalType": "String"
								}
							},
							{
								"source": {
									"name": "department",
									"type": "String",
									"physicalType": "varchar"
								},
								"sink": {
									"name": "department",
									"type": "String",
									"physicalType": "String"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DelimitedText11",
						"type": "DatasetReference",
						"parameters": {
							"filename": {
								"value": "@concat('dup_data_',utcNow())",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"annotations": []
	}
}